<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Supersource.Cli</RootNamespace>
    <!-- Keep the default Supersource.Cli assembly name. MSBuild compares assembly names
         case-insensitively, so "supersource" would collide with the referenced library. -->
  </PropertyGroup>
  <!-- Keep the CLI independent of kind libraries: it reads every file through its embedded schemas. -->
  <ItemGroup>
    <ProjectReference Include="..\Supersource\Supersource.csproj" />
  </ItemGroup>
</Project>
